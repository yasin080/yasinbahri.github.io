---
import Base from '../../layouts/Base.astro';
import ProjectPage from '../../components/ProjectPage.astro';
import { projectPaths } from '../../lib/projectPaths';
import { projectUrl } from '../../lib/site';

export const getStaticPaths = () => projectPaths('en');
const { project, prev, next, index, total } = Astro.props;
---

<Base lang="en" alternate={projectUrl('es', project.slug)} title={project.data.title} description={project.data.summary}>
  <ProjectPage lang="en" {project} {prev} {next} {index} {total} />
</Base>

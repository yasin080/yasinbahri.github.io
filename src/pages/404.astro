---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { homeUrl } from '../lib/site';
const t = ui.en.notFound;
const e = ui.es.notFound;
---

<Base lang="en" alternate={homeUrl('es')} title={t.title}>
  <section class="wrap nf">
    <p class="prompt"><b>$</b> cd ~/404</p>
    <h1 class="h1">404</h1>
    <p class="lede">{t.text}</p>
    <p class="lede" lang="es">{e.text}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={homeUrl('en')}>{t.back} <span class="ar e" aria-hidden="true">→</span></a>
      <a class="btn" href={homeUrl('es')} lang="es">{e.back} <span class="ar e" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

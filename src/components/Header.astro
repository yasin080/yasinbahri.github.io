---
import { ui, type Lang } from '../i18n/ui';
import { homeUrl } from '../lib/site';

interface Props { lang: Lang; alternate: string; isHome: boolean }
const { lang, alternate, isHome } = Astro.props;
const t = ui[lang];
const home = homeUrl(lang);
const here = Astro.url.pathname;
const enHref = lang === 'en' ? here : alternate;
const esHref = lang === 'es' ? here : alternate;
// Outside the home page the name is always visible.
---

<header class:list={['hdr', { 'brand-on': !isHome }]}>
  <div class="hdr-in">
    <a class="brand" href={home}>Yasin Bahri</a>
    <div class="nav-wrap">
      <nav class="nav" aria-label={t.navLabel}>
        <a href={`${home}#work`}>{t.nav.work}</a>
        <a href={`${home}#learn`}>{t.nav.learn}</a>
        <a href={`${home}#experience`}>{t.nav.experience}</a>
        <a href={`${home}#contact`}>{t.nav.contact}</a>
      </nav>
    </div>
    <div class="hdr-tools">
      <div class:list={['seg', { 'is-es': lang === 'es' }]} role="group" aria-label={t.langLabel}>
        <span class="thumb" aria-hidden="true"></span>
        <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        <a href={esHref} hreflang="es" lang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
      </div>
      <button
        type="button"
        class="icon-btn"
        data-theme-toggle
        data-to-dark={t.themeToDark}
        data-to-light={t.themeToLight}
        aria-label={t.themeToDark}
      >
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg>
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path></svg>
      </button>
    </div>
  </div>
</header>
